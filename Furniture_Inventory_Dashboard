  <script>
    function checkLogin() {
      if (!sessionStorage.getItem("isLoggedIn")) {
        new bootstrap.Modal(document.getElementById('loginModal')).show();
      } else {
        document.getElementById("mainDashboard").classList.remove("d-none");
      }
    }
if (!localStorage.getItem("username")) {
  localStorage.setItem("username", "admin");
  localStorage.setItem("password", "admin123");
}

    document.getElementById("loginForm").addEventListener("submit", function(e) {
      e.preventDefault();
      const user = document.getElementById("username").value;
      const pass = document.getElementById("password").value;
      const storedUser = localStorage.getItem("username");
const storedPass = localStorage.getItem("password");

if (user === storedUser && pass === storedPass) 
 {
        sessionStorage.setItem("isLoggedIn", true);
        document.getElementById("mainDashboard").classList.remove("d-none");
        bootstrap.Modal.getInstance(document.getElementById('loginModal')).hide();
      } else {
        alert("Invalid credentials. Try admin/admin123");
      }
    });

    function logout() {
      sessionStorage.removeItem("isLoggedIn");
      location.reload();
    }

    let inventory = JSON.parse(localStorage.getItem("inventory")) || [];

  let currentPage = 1;
  let itemsPerPage = 5;
  function changeRowsPerPage(value) {
  if (value === 'all') {
    itemsPerPage = inventory.length;
  } else {
    itemsPerPage = parseInt(value);
  }
  currentPage = 1;
  loadInventory(currentPage);
}
function loadInventory(page = 1)
 {

  const tbody = document.getElementById("inventoryBody");
  const pagination = document.getElementById("pagination");
  tbody.innerHTML = "";
  pagination.innerHTML = "";

  let total = inventory.length;
  let outOfStock = inventory.filter(i => i.quantity == 0).length;

  


  let sortedInventory = [...inventory];
const field = localStorage.getItem('sortField');
const order = localStorage.getItem('sortOrder');

if (field && order) {
  sortedInventory.sort((a, b) => {
    let aVal = a[field];
    let bVal = b[field];
     if (typeof aVal === 'string'&&typeof bVal === 'string') 
     {
     aVal = aVal.toLowerCase();
      bVal = bVal.toLowerCase();
     }
     else{
        aVal = parseFloat(aVal);
      bVal = parseFloat(bVal);
     }
if (aVal < bVal) return order === 'asc' ? -1 : 1;
      if (aVal > bVal) return order === 'asc' ? 1 : -1;
      return 0;
  });
}
const totalPages = Math.ceil(sortedInventory.length / itemsPerPage);
const validPage = Math.min(page, totalPages) || 1;
currentPage = validPage;

const start = (validPage - 1) * itemsPerPage;
const end = start + itemsPerPage;
const pageItems = sortedInventory.slice(start, end);


  pageItems.forEach((item, index) => {
    const row = `<tr class="${item.quantity <= 3 ? 'low-stock' : ''}">
      <td>${item.id}</td>
      <td>${item.name}</td>
      <td>${item.category}</td>
      <td data-field="quantity">${item.quantity}</td>
      <td data-field="">₹${item.price}</td>
      <td>${item.location}</td>
      <td>${item.image
        ? `<button class="btn btn-sm btn-outline-info" data-i18n="viewImage" onclick="showImageModal('${item.image}')">View Image</button>`
      : `<span class="text-muted">No Image</span>`
  }</td>
      <td>${item.quantity <= 3 ? 'Low Stock' : 'In Stock'}</td>
      <td>
        <button class="btn btn-sm btn-warning" data-i18n="edit" onclick="editItem(${inventory.indexOf(item)})">Edit</button>
        <button class="btn btn-sm btn-danger" data-i18n="delete" onclick="deleteItem(${inventory.indexOf(item)})">Delete</button>
      </td>
    </tr>`;
    tbody.insertAdjacentHTML("beforeend", row);
  });

  document.getElementById("totalItems").innerText = total;
  document.getElementById("outOfStock").innerText = outOfStock;

  const pageCount = Math.ceil(sortedInventory.length/itemsPerPage);
  for (let i = 1; i <= pageCount; i++) {
    const btn = document.createElement("button");
    btn.textContent = i;
    btn.className = `btn btn-sm mx-1 ${i ===currentPage ? 'btn-primary' : 'btn-outline-primary'}`;
    btn.onclick = () => {
      currentPage = i;
      loadInventory(i);
    };
    pagination.appendChild(btn);
  }
};
function addNotification(message, type, persist = false) {
  const notificationList = document.querySelector("#pills-notifications ul");
  const li = document.createElement("li");
  li.className = `list-group-item bg-${type} p-3`;
  li.textContent = message;
  notificationList.prepend(li);

  if (persist) {
    let saved = JSON.parse(localStorage.getItem("persistentNotifications")) || [];
    saved.unshift({ message, type });
    localStorage.setItem("persistentNotifications", JSON.stringify(saved));
  }
}

document.getElementById("itemForm").addEventListener("submit", function (e) {
  e.preventDefault();

  const existingId = document.getElementById("itemId").value;
  let id;

  if (existingId) {
    id = existingId; // Editing existing item
  } else {
    id = Date.now(); // Adding new item
  }

  const item = {
