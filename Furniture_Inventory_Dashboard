<script>
function loadPersistentNotifications() {
  const saved = JSON.parse(localStorage.getItem("persistentNotifications")) || [];
  const notificationList = document.querySelector("#pills-notifications ul");

  saved.forEach(n => {
    const li = document.createElement("li");
    li.className = `list-group-item bg-${n.type} p-3`;
    li.textContent = n.message;
    notificationList.appendChild(li);
  });
}
function removePersistentNotification(itemId) {
  let saved = JSON.parse(localStorage.getItem("persistentNotifications")) || [];
  saved = saved.filter(n => !n.message.includes(`#${itemId}`));
  localStorage.setItem("persistentNotifications", JSON.stringify(saved));
}
</script>
