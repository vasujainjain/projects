<script>
async function fetchLocation() {
  try {
    const res = await fetch('http://localhost:3000/api/location');
    const data = await res.json();
    document.getElementById("locationCity").innerText = data.city;
    document.getElementById("locationPincode").innerText = data.pincode;
  } catch (err) {
    console.error("Failed to load location", err);
  }
}

async function updateLocationPrompt() {
  const city = prompt("Enter City:");
  if (!city) return;

  try {
    const response = await fetch(`https://api.postalpincode.in/postoffice/${city}`);
    const data = await response.json();

    if (data[0].Status === "Success") {
      const postOffices = data[0].PostOffice;

      // Create a select dropdown dynamically
      const select = document.createElement("select");
      select.className = "form-select mt-2";
      select.innerHTML = postOffices.map(po =>
        `<option value="${po.Name}|${po.Pincode}">${po.Name} (${po.Pincode})</option>`
      ).join("");

      const confirmBtn = document.createElement("button");
      confirmBtn.innerText = "Confirm";
      confirmBtn.className = "btn btn-primary btn-sm mt-2";

      const modalDiv = document.createElement("div");
      modalDiv.style.position = "fixed";
      modalDiv.style.top = "30%";
      modalDiv.style.left = "50%";
      modalDiv.style.transform = "translate(-50%, -30%)";
      modalDiv.style.background = "#fff";
      modalDiv.style.padding = "20px";
      modalDiv.style.border = "1px solid #ccc";
      modalDiv.style.zIndex = 9999;
      modalDiv.style.boxShadow = "0px 4px 10px rgba(0,0,0,0.2)";
      modalDiv.innerHTML = `<h6>Select Your Area</h6>`;
      modalDiv.appendChild(select);
      modalDiv.appendChild(confirmBtn);
      document.body.appendChild(modalDiv);

      confirmBtn.onclick = async () => {
        const [area, pincode] = select.value.split("|");

        // Save to backend
        await fetch('http://localhost:3000/api/location', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ city: `${area}, ${city}`, pincode })
        });

        document.body.removeChild(modalDiv);
        alert(`Location updated: ${area}, ${city} - ${pincode}`);
        fetchLocation(); // refresh displayed info
      };

    } else {
      alert("City not found or invalid. Please try again.");
    }
  } catch (error) {
    console.error("Error fetching post offices:", error);
    alert("Failed to fetch areas for the entered city.");
  }
}
</script>

