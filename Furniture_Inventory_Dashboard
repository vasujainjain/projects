<script>
let pieChartInstance;

function initializePieChart() {
  const pieCtx = document.getElementById("pieChart").getContext("2d");
  pieChartInstance = new Chart(pieCtx, {
    type: 'pie',
    data: {
      labels: ['Seating', 'Dining', 'Sleeping', 'Studying', 'Swinging'],
      datasets: [{
        data: [0, 0, 0, 0, 0],
        backgroundColor: ['#ffc107', '#17a2b8', '#28a745', 'red', 'blue']
      }]
    }
  });
}

function updatePieChart() {
  const inventory = JSON.parse(localStorage.getItem("inventory")) || [];

  const categoryQuantities = {
    Seating: 0,
    Dining: 0,
    Sleeping: 0,
    Studying: 0,
    Swinging: 0
  };

  inventory.forEach(item => {
    const category = typeof item.category === "string" ? item.category : item.category?.EN || "";


    if (category.includes("Seating")) categoryQuantities.Seating += item.quantity;
    else if (category.includes("Dining")) categoryQuantities.Dining += item.quantity;
    else if (category.includes("Sleeping")) categoryQuantities.Sleeping += item.quantity;
    else if (category.includes("Studying")) categoryQuantities.Studying += item.quantity;
    else if (category.includes("Swinging")) categoryQuantities.Swinging += item.quantity;
  });

  pieChartInstance.data.datasets[0].data = [
    categoryQuantities.Seating,
    categoryQuantities.Dining,
    categoryQuantities.Sleeping,
    categoryQuantities.Studying,
    categoryQuantities.Swinging
  ];

  pieChartInstance.update();
}
</script>
